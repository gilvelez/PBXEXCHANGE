# PBX Exchange frontend environment template
# Copy to frontend/.env.local for local development if needed.
# Leave REACT_APP_BACKEND_URL empty for CRA proxy to http://localhost:8000.

# Local development
REACT_APP_BACKEND_URL=

# Optional production/cross-origin API URL.
# Use only when the deployed frontend should call a separately hosted FastAPI API.
# REACT_APP_BACKEND_URL=https://api.example.com

# Optional demo controls. Do not use live secrets in frontend env.
REACT_APP_DEMO_MODE=false
REACT_APP_ADMIN_MINT_KEY=change-me-for-local-demo-mint

# Optional Cursor visual edit tooling
REACT_APP_ENABLE_VISUAL_EDITS=false

