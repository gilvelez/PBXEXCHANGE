# PBX Exchange root environment template
# Safe placeholders only. Do not commit live credentials.

# Required for basic local backend operation
MONGODB_URI=mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017
DB_NAME=pbx_database
JWT_SECRET=replace-with-a-long-local-development-secret
AUTH_SECRET=replace-with-a-long-local-development-session-secret
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Optional admin/demo controls
ADMIN_PASSWORD=change-me-for-local-admin
ADMIN_MINT_KEY=change-me-for-local-demo-mint

# Optional email notifications (Resend)
RESEND_API_KEY=
SENDER_EMAIL=PBX Exchange <no-reply@example.com>

# Optional SMS notifications (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional sandbox Plaid
PLAID_MODE=MOCK
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional sandbox Circle
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_ENVIRONMENT=sandbox
CIRCLE_TREASURY_WALLET_ID=
CIRCLE_WEBHOOK_SECRET=

# Optional FX provider
OPENEXCHANGERATES_API_KEY=
OXR_API_KEY=

# Optional PayMongo sandbox
PAYMONGO_SECRET_KEY=

