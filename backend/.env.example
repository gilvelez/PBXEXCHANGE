# PBX Exchange backend environment template
# Copy to backend/.env for local FastAPI development.
# Never commit live secrets.

# Required for basic local operation
MONGODB_URI=mongodb://localhost:27017
MONGO_URL=mongodb://localhost:27017
DB_NAME=pbx_database
JWT_SECRET=replace-with-a-long-local-development-secret
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Optional local/admin controls
ADMIN_PASSWORD=change-me-for-local-admin
ADMIN_MINT_KEY=change-me-for-local-demo-mint

# Optional notifications
RESEND_API_KEY=
SENDER_EMAIL=PBX Exchange <no-reply@example.com>
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Optional Plaid sandbox; MOCK works without credentials
PLAID_MODE=MOCK
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

# Optional Circle sandbox; routes run in mock mode without credentials
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
CIRCLE_WALLET_SET_ID=
CIRCLE_ENVIRONMENT=sandbox
CIRCLE_TREASURY_WALLET_ID=
CIRCLE_WEBHOOK_SECRET=

# Optional FX provider; fallback rates are marked mock/indicative
OPENEXCHANGERATES_API_KEY=
OXR_API_KEY=

# Optional PayMongo sandbox
PAYMONGO_SECRET_KEY=

